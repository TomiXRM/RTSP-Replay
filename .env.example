# =============================================================================
# ロボット監視・リプレイシステム — 環境変数サンプル
# =============================================================================
# コピーして .env を作成し、値を書き換えてください。
# .env はGit管理対象外です（NFR-003: 認証情報をGitへコミットしない）。
# =============================================================================

# -----------------------------------------------------------------------------
# MediaMTX
# -----------------------------------------------------------------------------
# MediaMTX の管理APIベースURL
MEDIAMTX_API=http://mediamtx:9997
# MediaMTX のHLS配信ベース（フロントプロキシ経由の相対パスを基本とする）
MEDIAMTX_HLS_BASE=http://mediamtx:8888

# -----------------------------------------------------------------------------
# 録画
# -----------------------------------------------------------------------------
# 録画保存先。
# Docker 版: /recordings（コンテナ内パス。docker-compose のボリュームと一致）
# Docker 不要版: 未設定なら プロジェクト内 recordings/ を使用（推奨）
RECORDINGS_DIR=/recordings
# 直近保持時間（時間）。SPEC FR-015 既定値は 2
RECORDING_RETENTION_HOURS=2
# 録画セグメント長（秒）。SPEC FR-015 既定値は 60（1分）
RECORDING_SEGMENT_SECONDS=60

# -----------------------------------------------------------------------------
# 事故映像保存先（リング削除対象外）
# Docker 不要版は未設定なら プロジェクト内 data/incidents/ を使用
# -----------------------------------------------------------------------------
INCIDENTS_DIR=/data/incidents

# -----------------------------------------------------------------------------
# 動的設定データベース（UIから永続登録したソース・事故メタデータ）
# Docker 不要版は未設定なら プロジェクト内 data/replay.db を使用
# -----------------------------------------------------------------------------
DATABASE_PATH=/data/replay.db

# -----------------------------------------------------------------------------
# バックエンド
# -----------------------------------------------------------------------------
# APIサーバのホスト・ポート
API_HOST=0.0.0.0
API_PORT=8000
# CORS許可オリジン（カンマ区切り）。未設定時は同一LANを許可
CORS_ORIGINS=

# -----------------------------------------------------------------------------
# 映像ソースのRTSP認証情報（SPEC 7.1 推奨形式）
# -----------------------------------------------------------------------------
# TOMLの username_env / password_env が参照する環境変数名に合わせて設定する。
# 例: config/sources.toml の robot-overview が
#   username_env = "ROBOT_CAMERA_USERNAME"
#   password_env = "ROBOT_CAMERA_PASSWORD"
# を参照する場合、以下を設定する。
ROBOT_CAMERA_USERNAME=
ROBOT_CAMERA_PASSWORD=
PART_CAMERA_USERNAME=
PART_CAMERA_PASSWORD=
CONVEYOR_CAMERA_USERNAME=
CONVEYOR_CAMERA_PASSWORD=

# -----------------------------------------------------------------------------
# テスト用RTSPソース（docker-compose の ffmpeg 配信を参照する場合）
# -----------------------------------------------------------------------------
# ローカル検証時は config/sources.toml の rtsp_url を
# rtsp://testsrc-1:8554/cam1 のように書き換えて利用する。
